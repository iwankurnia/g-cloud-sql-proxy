<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CloudSqlProxyManager"
        x:Class="CloudSqlProxyManager.MainWindow"
        Title="Cloud SQL Proxy Manager"
        Width="640" Height="720" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Status band: light, state, one line of detail, and the one main button -->
    <Border x:Name="Header" DockPanel.Dock="Top" Background="{StaticResource OffTintBrush}" Padding="22,16,20,16">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Ellipse x:Name="Dot" Grid.Column="0" Width="14" Height="14" Fill="{StaticResource OffBrush}"
                 VerticalAlignment="Center" Margin="0,0,14,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock x:Name="StateText" Classes="state" Text="Disconnected" />
          <TextBlock x:Name="DetailText" Classes="detail" Text="" />
        </StackPanel>
        <Button x:Name="ActionButton" Grid.Column="2" Classes="primary action" Content="Connect"
                VerticalAlignment="Center" Margin="12,0,0,0" IsDefault="True" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairlineBrush}" />

    <Grid Margin="20,14,20,18" RowDefinitions="Auto,Auto,Auto,*">

      <TextBlock Grid.Row="0" Classes="heading" Text="Connection" />

      <Grid Grid.Row="1" ColumnDefinitions="112,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Saved" />
        <ComboBox x:Name="SavedBox" Grid.Row="0" Grid.Column="1" Margin="0,4" HorizontalAlignment="Stretch" />
        <Button x:Name="RemoveButton" Grid.Row="0" Grid.Column="2" Content="Remove" Margin="8,4,0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Project" />
        <local:ComboField x:Name="ProjectBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Watermark="type a project id, or choose one" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Region" />
        <local:ComboField x:Name="RegionBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Watermark="type a region, or choose one" />

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Instance" />
        <local:ComboField x:Name="InstanceBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Watermark="type an instance name, or choose one"
                  ToolTip.Tip="Type a name that is not listed to add it. Pasting a full project:region:instance fills all three fields." />

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="Local port" />
        <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" ColumnDefinitions="Auto,*,Auto">
          <NumericUpDown x:Name="PortBox" Grid.Column="0" Width="156" Minimum="1" Maximum="65535" Value="3306" Increment="1"
                         FormatString="0" ClipValueToMinMax="True" />
          <TextBlock x:Name="PortHint" Grid.Column="1" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" Text="" />
          <Button x:Name="PortSuggest" Grid.Column="2" Classes="link" VerticalAlignment="Center" Margin="8,0,0,0" Content="" IsVisible="False" />
        </Grid>

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="field" Text="Key file" />
        <TextBox x:Name="KeyBox" Grid.Row="5" Grid.Column="1" Margin="0,4" Watermark="service-account.json" />
        <Button x:Name="KeyBrowse" Grid.Row="5" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" />
        <TextBlock x:Name="KeyHint" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Classes="hint" Margin="2,0,0,6" Text="" />

        <CheckBox x:Name="AutoBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0" IsChecked="True"
                  Content="Reconnect automatically if the connection drops" />
        <CheckBox x:Name="HideBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0" IsChecked="True"
                  Content="Hide this window once connected (find it in the notification area)" />

        <Button x:Name="AdvancedToggle" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Classes="link" Margin="2,8,0,4"
                Content="Advanced options" HorizontalAlignment="Left" />

        <TextBlock x:Name="ProxyLabel" Grid.Row="10" Grid.Column="0" Classes="field" Text="Proxy program" />
        <TextBox x:Name="ProxyBox" Grid.Row="10" Grid.Column="1" Margin="0,4" />
        <Button x:Name="ProxyBrowse" Grid.Row="10" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" />
        <StackPanel x:Name="ProxyHintRow" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="2,0,0,6" Spacing="4">
          <TextBlock x:Name="ProxyHint" Classes="hint" Text="" />
          <Button x:Name="ProxyDownload" Classes="link" Content="Download it from Google" IsVisible="False" />
        </StackPanel>

        <TextBlock x:Name="ExtraLabel" Grid.Row="12" Grid.Column="0" Classes="field" Text="Extra arguments" />
        <TextBox x:Name="ExtraBox" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                 ToolTip.Tip="Optional extra cloud-sql-proxy flags, for example --private-ip or --auto-iam-authn" />
      </Grid>

      <TextBlock Grid.Row="2" Classes="heading" Text="Activity" Margin="0,14,0,10" />
      <TextBox x:Name="LogBox" Grid.Row="3" Classes="log" />
    </Grid>
  </DockPanel>
</Window>
